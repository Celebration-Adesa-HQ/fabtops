# Server-only WooCommerce REST API credentials. Never add a public prefix.
WOOCOMMERCE_STORE_URL=https://yourdomain.com
WOOCOMMERCE_CONSUMER_KEY=ck_replace_me
WOOCOMMERCE_CONSUMER_SECRET=cs_replace_me
WOOCOMMERCE_API_VERSION=wc/v3
FABTOPS_AUTH_CLIENT_SECRET=replace_with_shared_256_bit_secret
# Optional override for Store API cart and checkout.
# WOOCOMMERCE_STORE_API_BASE=https://yourdomain.com/wp-json/wc/store/v1
# Optional override for the storefront auth bridge.
# FABTOPS_AUTH_BASE_URL=https://yourdomain.com/wp-json/fabtops/v1
